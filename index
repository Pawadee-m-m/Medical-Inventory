<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>แดชบอร์ดสต็อกเวชภัณฑ์</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f2f5f4;--surface:#fff;--ink:#17262b;--muted:#5b6b70;--line:#d9e1df;--accent:#0e7c66;--warn:#b7791f;--bad:#b42318}
@media (prefers-color-scheme:dark){:root{--bg:#10191b;--surface:#18252a;--ink:#e7efed;--muted:#97a8ab;--line:#2a3a3f;--accent:#3cc4a6;--warn:#e0a84a;--bad:#f0877c}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.5 "Noto Sans Thai",system-ui,sans-serif}
.wrap{max-width:960px;margin:0 auto;padding:24px 16px 56px}
h1{font-size:22px;margin:0}
.meta{display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;margin:4px 0 20px;color:var(--muted);font-size:14px}
.badge{padding:2px 10px;border:1px solid var(--line);border-radius:999px;background:var(--surface);color:var(--ink);font-weight:500}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.stat{background:var(--surface);border:1px solid var(--line);border-top:4px solid var(--accent);border-radius:8px;padding:12px}
.stat.warn{border-top-color:var(--warn)}.stat.bad{border-top-color:var(--bad)}
.stat span{display:block;font-size:14px;color:var(--muted)}.stat b{font-size:26px;line-height:1.3}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:16px}
.card.wide{grid-column:1/-1}
h2{font-size:16px;margin:0 0 4px}.sub{font-size:13px;color:var(--muted);margin:0 0 12px}
.bar{display:grid;grid-template-columns:96px 1fr 40px;gap:8px;align-items:center;margin-top:6px;font-size:14px}
.bar i{display:block;height:10px;border-radius:5px;background:var(--accent)}.bar b{text-align:right}
.item{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-top:1px solid var(--line)}
.item:first-of-type{border-top:0}.item .s{font-size:13px;color:var(--muted)}
.tag{font-size:13px;font-weight:500;white-space:nowrap}.tag.warn{color:var(--warn)}.tag.bad{color:var(--bad)}
.empty{color:var(--muted);padding:8px 0}
@media (max-width:640px){.stats{grid-template-columns:1fr 1fr}.grid{grid-template-columns:1fr}.bar{grid-template-columns:72px 1fr 36px}}
</style>
</head>
<body>
<div class="wrap">
  <h1>แดชบอร์ดสต็อกเวชภัณฑ์</h1>
  <div class="meta"><span class="badge" id="src">กำลังโหลด</span><span id="upd"></span></div>
  <div class="stats" id="stats"></div>
  <div class="grid">
    <section class="card wide"><h2>ของที่จะหมดอายุ แยกตามเดือน</h2><p class="sub">จำนวนชิ้นที่เหลือ เฉพาะ 12 เดือนข้างหน้า</p><div id="months"></div></section>
    <section class="card"><h2>ต้องจัดการ</h2><p class="sub">หมดอายุแล้ว ใกล้หมดอายุ และของที่หมด</p><div id="todo"></div></section>
    <section class="card"><h2>สินค้าตามหมวด</h2><p class="sub">นับจำนวนสินค้า ไม่นับล็อตซ้ำ</p><div id="cats"></div></section>
    <section class="card wide"><h2>รายการล่าสุด</h2><p class="sub">ความเคลื่อนไหวที่บันทึกไว้ใน Transaction</p><div id="recent"></div></section>
  </div>
</div>

<script>
/* ตั้งค่า: เปลี่ยน source เป็น 'csv' แล้วใส่ลิงก์ Publish to web (รูปแบบ CSV) ของแต่ละแท็บ */
const CONFIG = {
  source: 'sample',
  stockCsv: '',
  txCsv: '',
  stockDateOrder: 'dmy',   // รูปแบบวันที่ในแท็บ Stock: dmy = วัน/เดือน/ปี, mdy = เดือน/วัน/ปี
  txDateOrder: 'mdy',      // รูปแบบวันที่ในแท็บ Transaction
  soonDays: 60
};

const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const DAY = 86400000;
const MONTHS = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
const midnight = d => new Date(d.getFullYear(), d.getMonth(), d.getDate());
const today = midnight(new Date());
const fmt = d => String(d.getDate()).padStart(2, '0') + '/' + String(d.getMonth() + 1).padStart(2, '0') + '/' + d.getFullYear();
const num = v => Number(String(v).replace(/,/g, '').replace(/[^\d.\-]/g, '')) || 0;

/* ---------- อ่านข้อมูล ---------- */
function parseCsv(t) {
  const rows = []; let row = [], cur = '', q = false;
  for (let i = 0; i < t.length; i++) {
    const c = t[i];
    if (q) { if (c === '"') { if (t[i + 1] === '"') { cur += '"'; i++; } else q = false; } else cur += c; }
    else if (c === '"') q = true;
    else if (c === ',') { row.push(cur); cur = ''; }
    else if (c === '\n') { row.push(cur); rows.push(row); row = []; cur = ''; }
    else if (c !== '\r') cur += c;
  }
  if (cur || row.length) { row.push(cur); rows.push(row); }
  return rows;
}
function objects(text) {
  const rows = parseCsv(text), head = rows[0].map(h => h.trim());
  return rows.slice(1).map(r => Object.fromEntries(head.map((h, i) => [h, (r[i] || '').trim()])));
}
function parseDate(s, order) {
  const m = String(s).match(/^(\d{1,4})[\/\-](\d{1,2})[\/\-](\d{1,4})$/);
  if (!m) return null;
  let a = +m[1], b = +m[2], c = +m[3], y, mo, d;
  if (a > 31) { y = a; mo = b; d = c; }
  else if (order === 'mdy') { mo = a; d = b; y = c; }
  else { d = a; mo = b; y = c; }
  if (y > 2400) y -= 543;
  if (mo < 1 || mo > 12) return null;
  return new Date(y, mo - 1, d);
}
async function fetchCsv(url) {
  const r = await fetch(url);
  if (!r.ok) throw new Error('โหลดไม่ได้ (' + r.status + ')');
  return objects(await r.text());
}
async function loadData() {
  if (CONFIG.source !== 'csv') return sample();
  const [s, t] = await Promise.all([fetchCsv(CONFIG.stockCsv), fetchCsv(CONFIG.txCsv)]);
  return {
    stock: s.filter(r => r['Lot Code']).map(r => ({
      lot: r['Lot Code'], item: r['Item ID'], name: r['ชื่อ'], size: r['ปริมาตร/ขนาด'], cat: r['หมวดหมู่'] || 'ไม่ระบุหมวด',
      unit: r['หน่วย'], qty: num(r['จำนวน']), exp: parseDate(r['วันหมดอายุ'], CONFIG.stockDateOrder)
    })),
    tx: t.filter(r => r['Lot Code'] && parseDate(r['วันที่'], CONFIG.txDateOrder)).map(r => ({
      date: parseDate(r['วันที่'], CONFIG.txDateOrder), lot: r['Lot Code'], type: r['ประเภทรายการ'], qty: num(r['จำนวน'])
    }))
  };
}

/* ข้อมูลตัวอย่าง ไม่ใช่ข้อมูลจริง วันที่ขยับตามวันนี้เพื่อให้แดชบอร์ดดูมีชีวิต */
function sample() {
  const d = n => new Date(today.getTime() + n * DAY);
  const S = (item, name, size, cat, unit, qty, exp) => ({ lot: item + (exp ? '-F' : '-LEG'), item, name, size, cat, unit, qty, exp });
  const stock = [
    S('EXT001-1', 'เจลแก้ปวดกล้ามเนื้อ', '250 ml', 'ยาใช้ภายนอก', 'หลอด', 12, d(430)),
    S('EXT002-1', 'น้ำยาฆ่าเชื้อ', '15 ml', 'ยาใช้ภายนอก', 'ขวด', 6, d(25)),
    S('EXT002-1', 'น้ำยาฆ่าเชื้อ', '15 ml', 'ยาใช้ภายนอก', 'ขวด', 4, d(380)),
    S('INT001-1', 'เกลือแร่', 'ซอง', 'ยาใช้ภายใน', 'ซอง', 90, d(-40)),
    S('INT002-1', 'ยาแก้ปวดลดไข้', '500 mg', 'ยาใช้ภายใน', 'เม็ด', 9, null),
    S('INT003-1', 'ยาแก้แพ้', '10 mg', 'ยาใช้ภายใน', 'เม็ด', 71, d(300)),
    S('INT004-1', 'ยาธาตุน้ำขาว', '100 ml', 'ยาใช้ภายใน', 'ขวด', 3, d(48)),
    S('WND001-1', 'น้ำเกลือ', '1000 ml', 'อุปกรณ์ทำแผล', 'ขวด', 1, d(210)),
    S('WND002-1', 'ผ้าก๊อซ', '3x3 นิ้ว', 'อุปกรณ์ทำแผล', 'กล่อง', 0, d(520)),
    S('WND003-1', 'พลาสเตอร์ปิดแผล', '', 'อุปกรณ์ทำแผล', 'กล่อง', 5, d(160)),
    S('OT001-1', 'ถุงมือยาง', 'ไซส์ M', 'อื่นๆ', 'ข้าง', 20, null),
    S('OT002-1', 'เทอร์โมมิเตอร์', '', 'อื่นๆ', 'อัน', 2, null)
  ];
  const T = (n, lot, type, qty) => ({ date: d(n), lot, type, qty });
  const tx = [
    T(-30, 'INT003-1-F', 'ปรับยอด', 80), T(-12, 'INT003-1-F', 'เบิก', 9),
    T(-20, 'WND001-1-F', 'ปรับยอด', 4), T(-9, 'WND001-1-F', 'เบิก', 3),
    T(-6, 'EXT002-1-F', 'รับเข้า', 4), T(-3, 'WND002-1-F', 'ปรับยอด', 0), T(-1, 'INT004-1-F', 'เบิก', 1)
  ];
  return { stock, tx };
}

/* ---------- คำนวณ ---------- */
function balance(s, list) {
  if (!list.length) return s.qty;
  const adj = list.filter(x => x.type === 'ปรับยอด');
  const last = adj.length ? Math.max(...adj.map(x => x.date.getTime())) : 0;
  const sum = f => list.filter(f).reduce((a, x) => a + x.qty, 0);
  return sum(x => x.type === 'ปรับยอด' && x.date.getTime() === last)
    + sum(x => x.type === 'รับเข้า' && x.date.getTime() > last)
    - sum(x => x.type === 'เบิก' && x.date.getTime() > last);
}
function compute(data) {
  const byLot = {};
  data.tx.forEach(t => (byLot[t.lot] = byLot[t.lot] || []).push(t));
  return data.stock.map(s => {
    const days = s.exp ? Math.round((midnight(s.exp) - today) / DAY) : null;
    return { ...s, qty: balance(s, byLot[s.lot] || []), days };
  }).filter(i => !(i.qty <= 0 && i.days !== null && i.days < 0));
}

/* ---------- แสดงผล ---------- */
function render(data) {
  const items = compute(data), soon = CONFIG.soonDays;
  const expired = items.filter(i => i.qty > 0 && i.days !== null && i.days < 0);
  const near = items.filter(i => i.qty > 0 && i.days !== null && i.days >= 0 && i.days <= soon).sort((a, b) => a.days - b.days);
  const out = items.filter(i => i.qty <= 0);
  const stat = (l, v, c) => '<div class="stat ' + (v && c ? c : '') + '"><span>' + l + '</span><b>' + v + '</b></div>';
  $('stats').innerHTML = stat('สินค้าทั้งหมด', new Set(items.map(i => i.item)).size, '') +
    stat('ใกล้หมดอายุ ' + soon + ' วัน', near.length, 'warn') + stat('หมดอายุแล้ว', expired.length, 'bad') + stat('ของหมด', out.length, 'bad');

  const buckets = Array.from({ length: 12 }, (_, k) => {
    const m = new Date(today.getFullYear(), today.getMonth() + k, 1);
    return { label: MONTHS[m.getMonth()] + ' ' + String(m.getFullYear()).slice(2), y: m.getFullYear(), m: m.getMonth(), qty: 0 };
  });
  items.forEach(i => { if (i.qty > 0 && i.exp && i.days >= 0) { const b = buckets.find(b => b.y === i.exp.getFullYear() && b.m === i.exp.getMonth()); if (b) b.qty += i.qty; } });
  const mx = Math.max(1, ...buckets.map(b => b.qty));
  $('months').innerHTML = buckets.map(b => '<div class="bar"><span>' + b.label + '</span><i style="width:' + (b.qty ? Math.max(2, Math.round(b.qty / mx * 100)) : 0) + '%"></i><b>' + b.qty + '</b></div>').join('');

  const row = (i, tag, cls) => '<div class="item"><div>' + esc(i.name) + (i.size ? ' ' + esc(i.size) : '') + '<div class="s">' + esc(i.lot) + ' เหลือ ' + i.qty + ' ' + esc(i.unit) + '</div></div><div class="tag ' + cls + '">' + tag + '</div></div>';
  const todo = expired.map(i => row(i, 'หมดอายุแล้ว', 'bad')).concat(near.map(i => row(i, 'อีก ' + i.days + ' วัน', 'warn')), out.map(i => row(i, 'ของหมด', 'bad')));
  $('todo').innerHTML = todo.length ? todo.join('') : '<div class="empty">ไม่มีรายการที่ต้องจัดการ</div>';

  const cats = {};
  items.forEach(i => { (cats[i.cat || 'ไม่ระบุหมวด'] = cats[i.cat || 'ไม่ระบุหมวด'] || new Set()).add(i.item); });
  const cm = Math.max(1, ...Object.values(cats).map(s => s.size));
  $('cats').innerHTML = Object.keys(cats).map(k => '<div class="bar"><span>' + esc(k) + '</span><i style="width:' + Math.round(cats[k].size / cm * 100) + '%"></i><b>' + cats[k].size + '</b></div>').join('');

  const name = lot => { const s = data.stock.find(s => s.lot === lot); return s ? s.name + (s.size ? ' ' + s.size : '') : lot; };
  const recent = data.tx.slice().sort((a, b) => b.date - a.date).slice(0, 8);
  $('recent').innerHTML = recent.length ? recent.map(t => '<div class="item"><div>' + esc(name(t.lot)) + '<div class="s">' + fmt(t.date) + ' ' + esc(t.type) + '</div></div><div class="tag">' + t.qty + '</div></div>').join('') : '<div class="empty">ยังไม่มีรายการ</div>';

  $('src').textContent = CONFIG.source === 'csv' ? 'ข้อมูลจาก Google Sheet' : 'ข้อมูลตัวอย่าง';
  $('upd').textContent = 'อัปเดตเมื่อ ' + fmt(new Date()) + ' ' + new Date().toTimeString().slice(0, 5);
}

loadData().then(render).catch(e => {
  $('src').textContent = 'โหลดข้อมูลไม่สำเร็จ';
  $('stats').innerHTML = '<div class="card wide">' + esc(e.message) + ' ตรวจลิงก์ CSV ใน CONFIG และดูว่าเปิด Publish to web แล้ว</div>';
});
</script>
</body>
</html>
